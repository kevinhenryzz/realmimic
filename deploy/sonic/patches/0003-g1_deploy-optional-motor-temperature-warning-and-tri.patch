 struct SafetyConfig {
   /// --enable-policy-guard / --policy-action-limit: stop when the policy's raw
@@ -21,6 +26,10 @@ struct SafetyConfig {
   /// --lowstate-timeout-ms: stop when the newest LowState is older than this
   /// (default: 500 ms, SONIC's threshold).
   std::chrono::milliseconds lowstate_timeout{500};
+  /// --motor-temp-warn: print once per motor when it reaches this [degC].
+  std::optional<int> motor_temp_warn;
+  /// --motor-temp-trip: stop when any motor reaches this [degC].
+  std::optional<int> motor_temp_trip;
 };
 
 /// Default bound of --enable-policy-guard.
@@ -33,3 +42,27 @@ bool is_finite_float(float value);
 /// Index of the first element of `action` that is NaN, +-Inf or larger than
 /// `limit` in magnitude; -1 if all are valid.
 int find_invalid_action(std::span<const float> action, float limit);
+
+/// Decision logic of --motor-temp-warn / --motor-temp-trip. Takes each motor's
+/// hotter reading (either sensor), as SONIC's own 90 degC warning does.
+class MotorTemperatureGuard {
+ public:
+  struct Result {
+    /// Motors that reached the warning threshold for the first time.
+    std::array<bool, G1_NUM_MOTOR> new_warning{};
+    /// First motor at or above the trip threshold, -1 if none.
+    int trip_motor = -1;
+  };
+
+  explicit MotorTemperatureGuard(const SafetyConfig& config)
+      : warn_(config.motor_temp_warn), trip_(config.motor_temp_trip) {}
+
+  bool enabled() const { return warn_.has_value() || trip_.has_value(); }
+
+  Result Update(std::span<const int16_t, G1_NUM_MOTOR> temperatures);
+
+ private:
+  std::optional<int> warn_;
+  std::optional<int> trip_;
+  std::array<bool, G1_NUM_MOTOR> warned_{};
+};
