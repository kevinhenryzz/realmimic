--- a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/safety_checks.cpp
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/safety_checks.cpp
@@ -18,3 +18,18 @@ int find_invalid_action(std::span<const float> action, float limit) {
   }
   return -1;
 }
+
+MotorTemperatureGuard::Result MotorTemperatureGuard::Update(
+    std::span<const int16_t, G1_NUM_MOTOR> temperatures) {
+  Result result;
+  for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+    if (warn_ && temperatures[i] >= *warn_ && !warned_[i]) {
+      warned_[i] = true;
+      result.new_warning[i] = true;
+    }
+    if (trip_ && temperatures[i] >= *trip_ && result.trip_motor < 0) {
+      result.trip_motor = i;
+    }
+  }
+  return result;
+}
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp
index e77c9f3..7defca3 100644
--- a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp
@@ -39,3 +39,64 @@ TEST(SafetyChecks, FindInvalidAction) {
     action[28] = std::numeric_limits<float>::quiet_NaN();
     EXPECT_EQ(find_invalid_action(action, 1e30F), 28);
 }
+
+TEST(SafetyChecks, MotorTemperatureGuardDisabledByDefault) {
+    MotorTemperatureGuard guard(SafetyConfig{});
+    EXPECT_FALSE(guard.enabled());
+    std::array<int16_t, G1_NUM_MOTOR> temperatures;
+    temperatures.fill(200);
+    const auto result = guard.Update(temperatures);
+    EXPECT_EQ(result.trip_motor, -1);
+    for (bool warned : result.new_warning) { EXPECT_FALSE(warned); }
+}
+
+TEST(SafetyChecks, MotorTemperatureGuardWarnsOncePerMotor) {
+    SafetyConfig config;
+    config.motor_temp_warn = 70;
+    MotorTemperatureGuard guard(config);
+    EXPECT_TRUE(guard.enabled());
+    std::array<int16_t, G1_NUM_MOTOR> temperatures;
+    temperatures.fill(40);
+    temperatures[3] = 70;
+
+    auto result = guard.Update(temperatures);
+    EXPECT_TRUE(result.new_warning[3]);
+    EXPECT_FALSE(result.new_warning[2]);
+    EXPECT_EQ(result.trip_motor, -1);
+
+    // Still hot, then cooled and hot again: reported only the first time.
+    result = guard.Update(temperatures);
+    EXPECT_FALSE(result.new_warning[3]);
+    temperatures[3] = 40;
+    guard.Update(temperatures);
+    temperatures[3] = 75;
+    temperatures[9] = 71;
+    result = guard.Update(temperatures);
+    EXPECT_FALSE(result.new_warning[3]);
+    EXPECT_TRUE(result.new_warning[9]);
+}
+
+TEST(SafetyChecks, MotorTemperatureGuardTrips) {
+    SafetyConfig config;
+    config.motor_temp_warn = 70;
+    config.motor_temp_trip = 90;
+    MotorTemperatureGuard guard(config);
+    std::array<int16_t, G1_NUM_MOTOR> temperatures;
+    temperatures.fill(40);
+    temperatures[5] = 89;
+    EXPECT_EQ(guard.Update(temperatures).trip_motor, -1);
+
+    temperatures[12] = 90;
+    temperatures[20] = 95;
+    const auto result = guard.Update(temperatures);
+    EXPECT_EQ(result.trip_motor, 12);  // first motor at or above the threshold
+    EXPECT_TRUE(result.new_warning[12]);
+    EXPECT_TRUE(result.new_warning[20]);
+
+    // Trip only (no warning level), and a zero threshold trips on the sim's 0 degC readings.
+    SafetyConfig trip_only;
+    trip_only.motor_temp_trip = 0;
+    MotorTemperatureGuard zero_guard(trip_only);
+    temperatures.fill(0);
+    EXPECT_EQ(zero_guard.Update(temperatures).trip_motor, 0);
+}
