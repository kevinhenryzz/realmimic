         last_action {0.0},
         last_left_hand_action {0.0},
         last_right_hand_action {0.0},
@@ -2223,6 +2225,12 @@ class G1Deploy {
                   << *safety_.policy_action_limit << std::endl;
       }
       std::cout << "[INFO] LowState timeout: " << safety_.lowstate_timeout.count() << " ms" << std::endl;
+      if (safety_.motor_temp_warn) {
+        std::cout << "[INFO] Motor temperature warning at " << *safety_.motor_temp_warn << " °C" << std::endl;
+      }
+      if (safety_.motor_temp_trip) {
+        std::cout << "[INFO] Motor temperature trip (damping) at " << *safety_.motor_temp_trip << " °C" << std::endl;
+      }
       
       // Initialize ChannelFactory
       ChannelFactory::Instance()->Init(0, networkInterface);
@@ -2833,6 +2841,33 @@ class G1Deploy {
         return false;
       }
 
+      return CheckMotorTemperatures(*ls);
+    }
+
+    /// Motor temperature guard (--motor-temp-warn / --motor-temp-trip): warns
+    /// once per motor; false once a motor reaches the trip threshold.
+    bool CheckMotorTemperatures(const LowState_& ls) {
+      if (!temperature_guard_.enabled()) { return true; }
+      std::array<int16_t, G1_NUM_MOTOR> temperatures;
+      for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+        const auto& t = ls.motor_state()[i].temperature();
+        temperatures[i] = std::max(t[0], t[1]);
+      }
+      const auto result = temperature_guard_.Update(temperatures);
+      for (int i = 0; i < G1_NUM_MOTOR; ++i) {
+        if (result.new_warning[i]) {
+          const auto& t = ls.motor_state()[i].temperature();
+          std::cout << "[WARNING] Motor " << i << " (hardware index) at " << t[0] << " / " << t[1]
+                    << " °C (sensor 0 / sensor 1), warning threshold " << *safety_.motor_temp_warn << " °C" << std::endl;
+        }
+      }
+      if (result.trip_motor >= 0) {
+        const auto& t = ls.motor_state()[result.trip_motor].temperature();
+        std::cout << "[SAFETY] Thermal guard tripped: motor " << result.trip_motor << " (hardware index) at "
+                  << t[0] << " / " << t[1] << " °C (sensor 0 / sensor 1), trip threshold "
+                  << *safety_.motor_temp_trip << " °C, switching to damping" << std::endl;
+        return false;
+      }
       return true;
     }
 
@@ -4244,6 +4279,8 @@ int main(int argc, char const* argv[]) {
     std::cout << "  --enable-policy-guard: stop (damping) if the policy's raw output is NaN/Inf or |a| > 20 on any joint" << std::endl;
     std::cout << "  --policy-action-limit <value>: enable the policy guard with this bound instead of 20" << std::endl;
     std::cout << "  --lowstate-timeout-ms <ms>: stop (damping) when the newest LowState is older than <ms> (default: 500)" << std::endl;
+    std::cout << "  --motor-temp-warn <degC>: print once per motor when its hotter temperature reading reaches <degC>" << std::endl;
+    std::cout << "  --motor-temp-trip <degC>: stop (damping) when any motor's hotter temperature reading reaches <degC>" << std::endl;
     std::cout << "  --stop-damping-ms <ms>: on any stop (O key, SIGINT/SIGTERM/SIGHUP, safety check) keep publishing" << std::endl;
     std::cout << "                          the damping command for <ms> before exiting (default: 1000)" << std::endl;
     std::cout << "\nExamples:" << std::endl;
@@ -4586,6 +4623,26 @@ int main(int argc, char const* argv[]) {
         std::cerr << "Error: --lowstate-timeout-ms requires a value argument" << std::endl;
         exit(1);
       }
+    } else if (std::string(argv[i]) == "--motor-temp-warn" || std::string(argv[i]) == "--motor-temp-trip") {
+      const std::string flag = argv[i];
+      if (i + 1 < argc) {
+        int threshold = -1;
+        try {
+          threshold = std::stoi(argv[i + 1]);
+        } catch (...) {
+          threshold = -1;
+        }
+        if (threshold < 0) {
+          std::cerr << "Error: " << flag << " must be a non-negative integer (degC)" << std::endl;
+          exit(1);
+        }
+        auto& setting = (flag == "--motor-temp-warn") ? safety_config.motor_temp_warn : safety_config.motor_temp_trip;
+        setting = threshold;
+        i++; // Skip the next argument since it's the threshold
+      } else {
+        std::cerr << "Error: " << flag << " requires a value argument" << std::endl;
+        exit(1);
+      }
     }
   }
 
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/safety_checks.cpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/safety_checks.cpp
