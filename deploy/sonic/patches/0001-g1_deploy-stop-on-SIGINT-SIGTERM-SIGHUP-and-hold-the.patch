From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Henry <kevinhenry2027@gmail.com>
Date: Sat, 24 Oct 2026 17:45:06 +0400
Subject: [PATCH 1/3] g1_deploy: stop on SIGINT/SIGTERM/SIGHUP and hold the
 damping command

Ctrl-C, SIGTERM or a dropped SSH session killed the runtime with the last
policy target standing on the motors. The signals now request the same stop
as the operator's O key: the handler only records the signal, the main loop
calls Stop().

Stop() used to send a single damping message after joining all threads. It
now stops the control thread first, switches the command writer to the
damping command, and keeps it publishing at 500 Hz for --stop-damping-ms
(default 1000) before the final write, so one lost DDS message cannot leave
the robot holding the last target. This applies to every stop (O key,
signals, safety checks); --stop-damping-ms 0 disables the hold.
---
 .../src/g1_deploy_onnx_ref.cpp                | 76 ++++++++++++++++---
 1 file changed, 66 insertions(+), 10 deletions(-)

diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/g1_deploy_onnx_ref.cpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/g1_deploy_onnx_ref.cpp
index a9ee7af..b78f625 100644
--- a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/g1_deploy_onnx_ref.cpp
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/g1_deploy_onnx_ref.cpp
@@ -47,7 +47,9 @@
  *   --motor-kp-scale      | Scale selected hardware motor Kp gains
  *   --motor-kd-scale      | Scale selected hardware motor Kd gains
  */
+#include <atomic>
 #include <cmath>
+#include <csignal>
 #include <cuda_runtime_api.h>
 #include <memory>
 #include <mutex>
@@ -2715,21 +2717,34 @@ class G1Deploy {
       dex3_hands_.writeOnce();
     }
 
-    /// Gracefully stop all threads and send a damping-only command.
-    void Stop() {
+    /**
+     * @brief Gracefully stop all threads and send a damping-only command.
+     *
+     * The command writer is stopped last: once the control thread has exited it
+     * keeps publishing the damping command at 500 Hz for `damping_hold`, so a
+     * lost DDS message cannot leave the robot holding the last policy target.
+     */
+    void Stop(std::chrono::milliseconds damping_hold) {
       operator_state.stop = true;
 
       if (control_thread_ptr_) {
-        input_thread_ptr_->Wait();
-        input_thread_ptr_.reset();
         control_thread_ptr_->Wait();
         control_thread_ptr_.reset();
-        command_writer_ptr_->Wait();
-        command_writer_ptr_.reset();
+        CreateDampingCommand();
+        const auto damping_start = std::chrono::steady_clock::now();
+        input_thread_ptr_->Wait();
+        input_thread_ptr_.reset();
         if (planner_thread_ptr_) {
           planner_thread_ptr_->Wait();
           planner_thread_ptr_.reset();
         }
+        std::this_thread::sleep_until(damping_start + damping_hold);
+        command_writer_ptr_->Wait();
+        command_writer_ptr_.reset();
+        std::cout << "Damping held for "
+                  << std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now() - damping_start).count()
+                  << " ms" << std::endl;
       }
       CreateDampingCommand();
       LowCommandWriter();
@@ -4133,6 +4148,20 @@ static bool parse_motor_gain_scale_flag(
   return true;
 }
 
+// SIGINT / SIGTERM / SIGHUP request the same stop as the operator's O key.
+// The handler only records the signal (async-signal-safe); main() acts on it.
+static std::atomic<int> stop_signal{0};
+static_assert(std::atomic<int>::is_always_lock_free);
+
+extern "C" void handle_stop_signal(int signum) { stop_signal.store(signum); }
+
+static void install_stop_signal_handlers() {
+  struct sigaction action {};
+  action.sa_handler = handle_stop_signal;
+  sigemptyset(&action.sa_mask);
+  for (int signum : {SIGINT, SIGTERM, SIGHUP}) { sigaction(signum, &action, nullptr); }
+}
+
 /**
  * @brief Entry point: parse CLI arguments and run the G1 deployment application.
  *
@@ -4190,6 +4219,8 @@ int main(int argc, char const* argv[]) {
     std::cout << "  --max-close-ratio <value>: set initial hand max close ratio (0.2-1.0; default: 1.0 = full closure)" << std::endl;
     std::cout << "                             0.2 = limited (80% open), 1.0 = full closure allowed" << std::endl;
     std::cout << "                             Keyboard controls: x/c = +/- 0.1 (always available)" << std::endl;
+    std::cout << "  --stop-damping-ms <ms>: on any stop (O key, SIGINT/SIGTERM/SIGHUP, safety check) keep publishing" << std::endl;
+    std::cout << "                          the damping command for <ms> before exiting (default: 1000)" << std::endl;
     std::cout << "\nExamples:" << std::endl;
     std::cout << "  " << argv[0] << " enp5s0 policy/single_frame/model.onnx reference/bones_072925_test/ --planner-file policy/planner.onnx --obs-config policy/single_frame/observation_config.yaml --disable-crc-check" << std::endl;
     std::cout << "  " << argv[0] << " enp5s0 policy/token/model.onnx reference/bones_072925_test/ --obs-config policy/token/observation_config.yaml --encoder-file policy/token/encoder.onnx" << std::endl;
@@ -4234,6 +4265,7 @@ int main(int argc, char const* argv[]) {
   std::array<double, 3> initial_compliance = {0.5, 0.5, 0.0}; // initial compliance is 0.5 for both hands (keyboard controllable)
   double initial_max_close_ratio = 1.0; // default allows full closure, use --max-close-ratio to limit
   MotorGainScaleConfig motor_gain_scales;
+  int stop_damping_ms = 1000;
   for (int i = 4; i < argc; i++) {
     if (std::string(argv[i]) == "--disable-crc-check") {
       disableCrcCheck = true;
@@ -4471,6 +4503,23 @@ int main(int argc, char const* argv[]) {
         std::cerr << "Error: --max-close-ratio requires a value argument" << std::endl;
         exit(1);
       }
+    } else if (std::string(argv[i]) == "--stop-damping-ms") {
+      if (i + 1 < argc) {
+        try {
+          stop_damping_ms = std::stoi(argv[i + 1]);
+        } catch (...) {
+          stop_damping_ms = -1;
+        }
+        if (stop_damping_ms < 0) {
+          std::cerr << "Error: --stop-damping-ms must be a non-negative integer" << std::endl;
+          exit(1);
+        }
+        std::cout << "[INFO] Damping hold on stop: " << stop_damping_ms << " ms" << std::endl;
+        i++; // Skip the next argument since it's the duration
+      } else {
+        std::cerr << "Error: --stop-damping-ms requires a value argument" << std::endl;
+        exit(1);
+      }
     }
   }
 
@@ -4507,25 +4556,32 @@ int main(int argc, char const* argv[]) {
     motor_gain_scales
   );
   std::cout << "[DEBUG] G1Deploy object created successfully!" << std::endl;
+  // Installed after construction: until the control threads start, no command
+  // has been sent and the default action (terminate) is harmless. Replaces, with
+  // ROS2, rclcpp's SIGINT handler.
+  install_stop_signal_handlers();
   
   // Main application loop - check both operator_state.stop and ROS2 status if using ROS2
 #if HAS_ROS2
   if (inputType == "ros2") {
-    while (!custom.operator_state.stop && rclcpp::ok()) { 
+    while (!custom.operator_state.stop && !stop_signal && rclcpp::ok()) {
       sleep(0.02); 
     }
     if (!rclcpp::ok()) {
       std::cout << "[INFO] ROS2 shutdown detected (Ctrl+C)" << std::endl;
     }
   } else {
-    while (!custom.operator_state.stop) { sleep(0.02); }
+    while (!custom.operator_state.stop && !stop_signal) { sleep(0.02); }
   }
 #else
-  while (!custom.operator_state.stop) { sleep(0.02); }
+  while (!custom.operator_state.stop && !stop_signal) { sleep(0.02); }
 #endif
+  if (stop_signal) {
+    std::cout << "[INFO] Received " << strsignal(stop_signal) << ", stopping control (damping)" << std::endl;
+  }
   
   std::cout << "[DEBUG] Stopping G1Deploy..." << std::endl;
-  custom.Stop();
+  custom.Stop(std::chrono::milliseconds(stop_damping_ms));
   std::cout << "[DEBUG] Waiting for cleanup..." << std::endl;
   sleep(0.5);
   std::cout << "[DEBUG] Program exiting normally..." << std::endl;
