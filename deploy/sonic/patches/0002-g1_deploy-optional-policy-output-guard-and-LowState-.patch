index 0000000..e4cdd94
--- /dev/null
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/safety_checks.cpp
@@ -0,0 +1,20 @@
+#include "safety_checks.hpp"
+
+#include <bit>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+bool is_finite_float(float value) {
+  constexpr std::uint32_t kExponentMask = 0x7F800000U;
+  return (std::bit_cast<std::uint32_t>(value) & kExponentMask) != kExponentMask;
+}
+
+int find_invalid_action(std::span<const float> action, float limit) {
+  for (std::size_t i = 0; i < action.size(); ++i) {
+    if (!is_finite_float(action[i]) || std::fabs(action[i]) > limit) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp
new file mode 100644
index 0000000..e77c9f3
--- /dev/null
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_safety_checks.cpp
@@ -0,0 +1,41 @@
+#include <gtest/gtest.h>
+
+#include "../include/safety_checks.hpp"
+
+#include <array>
+#include <limits>
+
+// Built with the runtime's flags (-O3 -ffast-math): these also check that the
+// NaN/Inf detection survives fast-math.
+
+TEST(SafetyChecks, IsFiniteFloat) {
+    EXPECT_TRUE(is_finite_float(0.0F));
+    EXPECT_TRUE(is_finite_float(-1.5F));
+    EXPECT_TRUE(is_finite_float(std::numeric_limits<float>::max()));
+    EXPECT_TRUE(is_finite_float(std::numeric_limits<float>::denorm_min()));
+    EXPECT_FALSE(is_finite_float(std::numeric_limits<float>::quiet_NaN()));
+    EXPECT_FALSE(is_finite_float(-std::numeric_limits<float>::quiet_NaN()));
+    EXPECT_FALSE(is_finite_float(std::numeric_limits<float>::signaling_NaN()));
+    EXPECT_FALSE(is_finite_float(std::numeric_limits<float>::infinity()));
+    EXPECT_FALSE(is_finite_float(-std::numeric_limits<float>::infinity()));
+}
+
+TEST(SafetyChecks, FindInvalidAction) {
+    std::array<float, 29> action{};
+    action[3] = 19.9F;
+    action[4] = -20.0F;
+    EXPECT_EQ(find_invalid_action(action, 20.0F), -1);
+
+    action[7] = 20.5F;
+    EXPECT_EQ(find_invalid_action(action, 20.0F), 7);
+    action[7] = -100.0F;
+    EXPECT_EQ(find_invalid_action(action, 20.0F), 7);
+    action[2] = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_EQ(find_invalid_action(action, 20.0F), 2);
+
+    action = {};
+    action[28] = std::numeric_limits<float>::infinity();
+    EXPECT_EQ(find_invalid_action(action, 20.0F), 28);
+    action[28] = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_EQ(find_invalid_action(action, 1e30F), 28);
+}
