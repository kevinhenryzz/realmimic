+/**
+ * @file safety_checks.hpp
+ * @brief Optional safety checks of the control loop and their decision logic.
+ *
+ * Every check stops control like the operator's O key (damping, then exit).
+ * They are configured from the command line (see main()) and are off by
+ * default unless noted. The logic is kept free of DDS / TensorRT so that it is
+ * unit tested (unit_tests/test_safety_checks.cpp).
+ */
+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <span>
+
+struct SafetyConfig {
+  /// --enable-policy-guard / --policy-action-limit: stop when the policy's raw
+  /// output (before action scale and default angles) is NaN/Inf or exceeds
+  /// this magnitude on any joint.
+  std::optional<float> policy_action_limit;
+  /// --lowstate-timeout-ms: stop when the newest LowState is older than this
+  /// (default: 500 ms, SONIC's threshold).
+  std::chrono::milliseconds lowstate_timeout{500};
+};
+
+/// Default bound of --enable-policy-guard.
+constexpr float kDefaultPolicyActionLimit = 20.0F;
+
+/// False for NaN and +-Inf. Reads the IEEE-754 bit pattern: this target builds
+/// with -ffast-math, under which std::isfinite / std::isnan may be folded away.
+bool is_finite_float(float value);
+
+/// Index of the first element of `action` that is NaN, +-Inf or larger than
+/// `limit` in magnitude; -1 if all are valid.
+int find_invalid_action(std::span<const float> action, float limit);
